# Copy to .env and fill in what you have. Everything is optional except
# Google sign-in, which is required for people to log in.

# --- Google sign-in (required) ---------------------------------------------
# Create at https://console.cloud.google.com/apis/credentials
# OAuth client ID → Web application → add this authorized redirect URI:
#   http://127.0.0.1:8000/auth/google/callback   (plus your public URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed behind a reverse proxy / custom domain:
# OAUTH_REDIRECT_URL=https://yourdomain.com/auth/google/callback

# --- AI analyst (optional) --------------------------------------------------
# https://platform.claude.com → API keys. Enables the "Explain this case"
# plain-English summaries.
ANTHROPIC_API_KEY=
# REPORTIT_AI_MODEL=claude-opus-4-8

# --- Threat intel (optional, all free tiers) --------------------------------
VT_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_API_KEY=
